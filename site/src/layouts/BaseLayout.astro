---
import "@fontsource-variable/manrope";
import "@fontsource-variable/unbounded";
import "../styles/global.css";
import { CRIME_CHANNELS, ROBLOX_CHANNEL } from "../config/channels";
import { withBase } from "../lib/events";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
  ogType?: "website" | "article";
  socialImage?: string;
  socialImageAlt?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  hubHome?: boolean;
}

const {
  title,
  description,
  noindex = false,
  canonicalPath,
  ogType = "website",
  socialImage,
  socialImageAlt = "По факту — тематический медиахаб",
  structuredData,
  hubHome = false,
} = Astro.props;
const currentPath = Astro.url.pathname;
const isRoblox = currentPath.includes("/roblox");
const isAbout = currentPath.includes("/about");
const canonical = canonicalPath
  ? new URL(withBase(canonicalPath), Astro.site ?? Astro.url).toString()
  : undefined;
const socialUrl = canonical ?? new URL(currentPath, Astro.site ?? Astro.url).toString();
const resolvedSocialImage = socialImage
  ?? new URL(withBase("/og-default.png"), Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eadc" />
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("pofaktu-theme");
        const theme = storedTheme === "light" || storedTheme === "dark"
          ? storedTheme
          : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          "content",
          theme === "dark" ? "#151719" : "#f1eadc",
        );
      })();
    </script>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="По факту" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={socialUrl} />
    <meta property="og:image" content={resolvedSocialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedSocialImage} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
      />
    )}
    <title>{title}</title>
  </head>
  <body class:list={{ "is-hub-home": hubHome }}>
    <a class="skip-link" href="#content">Перейти к содержанию</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={withBase("/")}>
          <span class="brand-prefix">по</span>
          <span class="brand-name">факту</span>
          <span class="brand-note">тематический медиахаб</span>
        </a>
        <div class="header-actions">
          {hubHome ? (
            <nav aria-label="Основная навигация">
              <a href="#themes">Все темы</a>
              <a href={withBase("/about/")}>О проекте</a>
            </nav>
          ) : (
            <nav aria-label="Основная навигация">
              <a
                class:list={{ active: currentPath.includes("/crime") }}
                href={withBase("/crime/")}
              >Криминал</a>
              <a
                class:list={{ active: isRoblox }}
                href={withBase("/roblox/")}
              >Roblox</a>
              <a
                class:list={{ active: currentPath.includes("/about") }}
                href={withBase("/about/")}
              >О проекте</a>
            </nav>
          )}
          <button
            class="theme-toggle"
            type="button"
            aria-label="Включить тёмную тему"
            title="Включить тёмную тему"
          >
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path>
            </svg>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3.5"></circle>
              <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    {!hubHome && <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <strong>По факту</strong>
          <span>События, источники и обновления.</span>
        </div>
        {isAbout ? (
          <p>Тематические материалы, источники и удобный переход в наши каналы.</p>
        ) : isRoblox ? (
          <p>Новости, обновления и полезные материалы по Roblox и Brawl Stars.</p>
        ) : (
          <p>
            Публикация информации о расследовании не означает доказанную
            виновность упомянутых лиц.
          </p>
        )}
        <div class="footer-follow">
          <p class="footer-status">
            Раздел: <strong>{isAbout ? "О проекте" : isRoblox ? "Roblox" : "Криминал"}</strong>
          </p>
          {isAbout ? (
            <a class="text-action" href={withBase("/")}>Все темы</a>
          ) : isRoblox ? (
            <div class="footer-channels" aria-label="Канал Roblox">
              <a href={ROBLOX_CHANNEL.telegram.url} rel="noopener noreferrer" target="_blank">
                Telegram
              </a>
              <a href={ROBLOX_CHANNEL.max.url} rel="noopener noreferrer" target="_blank">
                MAX
              </a>
            </div>
          ) : (
            <div class="footer-channels" aria-label="Каналы криминального направления">
              <a href={CRIME_CHANNELS.telegram.url} rel="noopener noreferrer" target="_blank">
                Telegram
              </a>
              <a href={CRIME_CHANNELS.max.url} rel="noopener noreferrer" target="_blank">
                MAX
              </a>
            </div>
          )}
        </div>
      </div>
    </footer>}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector(".theme-toggle");
        if (!(toggle instanceof HTMLButtonElement)) return;

        const syncLabel = () => {
          const dark = root.dataset.theme === "dark";
          const label = dark ? "Включить светлую тему" : "Включить тёмную тему";
          toggle.setAttribute("aria-label", label);
          toggle.title = label;
          toggle.setAttribute("aria-pressed", String(dark));
        };

        syncLabel();
        toggle.addEventListener("click", () => {
          const theme = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = theme;
          localStorage.setItem("pofaktu-theme", theme);
          document.querySelector('meta[name="theme-color"]')?.setAttribute(
            "content",
            theme === "dark" ? "#151719" : "#f1eadc",
          );
          syncLabel();
        });
      })();
    </script>
  </body>
</html>
