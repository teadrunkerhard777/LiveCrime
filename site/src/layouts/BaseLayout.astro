---
import "@fontsource-variable/manrope";
import "@fontsource-variable/unbounded";
import "../styles/global.css";
import { CRIME_CHANNELS } from "../config/channels";
import { withBase } from "../lib/events";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
  ogType?: "website" | "article";
  socialImage?: string;
  socialImageAlt?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  canonicalPath,
  ogType = "website",
  socialImage,
  socialImageAlt = "По факту — тематический медиахаб",
  structuredData,
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonical = canonicalPath
  ? new URL(withBase(canonicalPath), Astro.site ?? Astro.url).toString()
  : undefined;
const socialUrl = canonical ?? new URL(currentPath, Astro.site ?? Astro.url).toString();
const resolvedSocialImage = socialImage
  ?? new URL(withBase("/og-default.png"), Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eadc" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="По факту" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={socialUrl} />
    <meta property="og:image" content={resolvedSocialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedSocialImage} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
      />
    )}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Перейти к содержанию</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={withBase("/")}>
          <span class="brand-prefix">по</span>
          <span class="brand-name">факту</span>
          <span class="brand-note">тематический медиахаб</span>
        </a>
        <nav aria-label="Основная навигация">
          <a
            class:list={{ active: currentPath.includes("/crime") }}
            href={withBase("/crime/")}
          >Криминал</a>
          <a
            class:list={{ active: currentPath.includes("/about") }}
            href={withBase("/about/")}
          >О проекте</a>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <strong>По факту</strong>
          <span>Главное остаётся на своём месте.</span>
        </div>
        <p>
          Публикация информации о расследовании не означает доказанную
          виновность упомянутых лиц.
        </p>
        <div class="footer-follow">
          <p class="footer-status">
            Пилотное направление: <strong>Криминал</strong>
          </p>
          <div class="footer-channels" aria-label="Каналы криминального направления">
            <a href={CRIME_CHANNELS.telegram.url} rel="noopener noreferrer" target="_blank">
              Telegram
            </a>
            <a href={CRIME_CHANNELS.max.url} rel="noopener noreferrer" target="_blank">
              MAX
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
