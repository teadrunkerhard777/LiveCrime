---
import { getCollection } from "astro:content";
import TelegramPostCard from "../../components/TelegramPostCard.astro";
import { CARS_CHANNEL } from "../../config/channels";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("cars")).sort(
  (first, second) => second.data.published_at.valueOf() - first.data.published_at.valueOf(),
);
---

<BaseLayout
  title="Автомобильные новости, новинки и технологии | По факту"
  description="Свежие автомобильные новости: новые модели, технологии, рынок, дорожные события и полезные материалы для автомобилистов."
  canonicalPath="/cars/"
>
  <header class="roblox-masthead cars-masthead">
    <div class="shell roblox-masthead-grid">
      <div>
        <h1>Авто <span>новости и технологии</span></h1>
      </div>
      <div class="roblox-intro">
        <p>
          Новые автомобили, технологии, события рынка и полезные материалы для
          тех, кто интересуется машинами и дорогой.
        </p>
        <div class="roblox-channel-actions" aria-label="Автомобильные каналы в мессенджерах">
          <a href={CARS_CHANNEL.telegram.url} rel="noopener noreferrer" target="_blank">
            Читать в Telegram ↗
          </a>
          <a href={CARS_CHANNEL.max.url} rel="noopener noreferrer" target="_blank">
            Читать в MAX ↗
          </a>
        </div>
      </div>
    </div>
  </header>

  <section class="shell roblox-feed cars-feed" aria-labelledby="cars-feed-title">
    <div class="roblox-feed-heading">
      <div>
        <span>Автомобильные новости</span>
        <h2 id="cars-feed-title">Последние публикации</h2>
      </div>
      <p>{posts.length} {posts.length === 1 ? "пост" : "постов"}</p>
    </div>

    {posts.length ? (
      <div class="roblox-posts">
        {posts.map((post) => (
          <TelegramPostCard
            post={post}
            channelName="Авто новости"
            imageAlt="Изображение из автомобильной публикации"
            maxUrl={CARS_CHANNEL.max.url}
          />
        ))}
      </div>
    ) : (
      <div class="roblox-empty">
        <strong>Лента подключена</strong>
        <p>Первые автомобильные публикации появятся после ближайшего обновления.</p>
        <a href={CARS_CHANNEL.telegram.url} rel="noopener noreferrer" target="_blank">
          Пока открыть канал в Telegram
        </a>
      </div>
    )}
  </section>
</BaseLayout>
