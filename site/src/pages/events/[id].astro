---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/events";

export async function getStaticPaths() {
  const events = await getCollection("events", ({ data }) => !data.draft);
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props {
  event: CollectionEntry<"events">;
}

const { event } = Astro.props;
const destination = withBase(`/crime/${event.id}/`);
---

<BaseLayout
  title="Карточка перемещена — По факту"
  description="Карточка события теперь находится в разделе Криминал."
  noindex={true}
>
  <section class="shell moved-page">
    <h1>Карточка перемещена</h1>
    <p>Теперь материалы этого направления находятся в разделе «Криминал».</p>
    <a class="primary-action" href={destination}>Открыть новый адрес</a>
  </section>
  <script is:inline define:vars={{ destination }}>
    window.location.replace(destination);
  </script>
</BaseLayout>
