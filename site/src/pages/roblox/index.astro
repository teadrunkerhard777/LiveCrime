---
import { getCollection } from "astro:content";
import RobloxPostCard from "../../components/RobloxPostCard.astro";
import { ROBLOX_CHANNEL } from "../../config/channels";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("roblox")).sort(
  (first, second) => second.data.published_at.valueOf() - first.data.published_at.valueOf(),
);
---

<BaseLayout
  title="Roblox — свежие посты Roblox Hub | По факту"
  description="Публикации Roblox Hub с изображениями и текстом: обновления игр, полезные советы, новинки и находки сообщества."
  canonicalPath="/roblox/"
>
  <header class="roblox-masthead">
    <div class="shell roblox-masthead-grid">
      <div>
        <span class="roblox-kicker">второй раздел хаба</span>
        <h1>Roblox</h1>
      </div>
      <div class="roblox-intro">
        <p>
          Свежие публикации Roblox Hub — здесь в том же виде, в котором они
          выходят в Telegram: изображение, текст и ссылка на оригинал.
        </p>
        <a href={ROBLOX_CHANNEL.url} rel="noopener noreferrer" target="_blank">
          Читать канал в Telegram ↗
        </a>
      </div>
    </div>
  </header>

  <section class="shell roblox-feed" aria-labelledby="roblox-feed-title">
    <div class="roblox-feed-heading">
      <div>
        <span>Прямая лента</span>
        <h2 id="roblox-feed-title">Последние публикации</h2>
      </div>
      <p>{posts.length} {posts.length === 1 ? "пост" : "постов"}</p>
    </div>

    {posts.length ? (
      <div class="roblox-posts">
        {posts.map((post) => <RobloxPostCard post={post} />)}
      </div>
    ) : (
      <div class="roblox-empty">
        <strong>Лента подключена</strong>
        <p>Первые публикации появятся здесь после ближайшей синхронизации с Telegram.</p>
        <a href={ROBLOX_CHANNEL.url} rel="noopener noreferrer" target="_blank">
          Пока открыть Roblox Hub
        </a>
      </div>
    )}
  </section>
</BaseLayout>
