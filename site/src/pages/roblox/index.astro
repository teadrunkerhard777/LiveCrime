---
import { getCollection } from "astro:content";
import TelegramPostCard from "../../components/TelegramPostCard.astro";
import { ROBLOX_CHANNEL } from "../../config/channels";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("roblox")).sort(
  (first, second) => second.data.published_at.valueOf() - first.data.published_at.valueOf(),
);
---

<BaseLayout
  title="Roblox и Brawl Stars — новости и гайды | По факту"
  description="Свежие новости Roblox и Brawl Stars: обновления, события, режимы, промокоды, полезные советы и материалы игрового сообщества."
  canonicalPath="/roblox/"
>
  <header class="roblox-masthead">
    <div class="shell roblox-masthead-grid">
      <div>
        <h1>Roblox <span>и Brawl Stars</span></h1>
      </div>
      <div class="roblox-intro">
        <p>
          Новости, обновления, события и полезные материалы о Roblox и Brawl Stars.
          Следите за новыми режимами, игровыми находками и важными изменениями.
        </p>
        <div class="roblox-channel-actions" aria-label="Игровые каналы в мессенджерах">
          <a href={ROBLOX_CHANNEL.telegram.url} rel="noopener noreferrer" target="_blank">
            Читать в Telegram ↗
          </a>
          <a href={ROBLOX_CHANNEL.max.url} rel="noopener noreferrer" target="_blank">
            Читать в MAX ↗
          </a>
        </div>
      </div>
    </div>
  </header>

  <section class="shell roblox-feed" aria-labelledby="roblox-feed-title">
    <div class="roblox-feed-heading">
      <div>
        <span>Игровые новости</span>
        <h2 id="roblox-feed-title">Roblox и Brawl Stars</h2>
      </div>
      <p>{posts.length} {posts.length === 1 ? "пост" : "постов"}</p>
    </div>

    {posts.length ? (
      <div class="roblox-posts">
        {posts.map((post) => (
          <TelegramPostCard
            post={post}
            channelName="Roblox Hub"
            imageAlt="Изображение из публикации Roblox Hub"
            maxUrl={ROBLOX_CHANNEL.max.url}
          />
        ))}
      </div>
    ) : (
      <div class="roblox-empty">
        <strong>Лента подключена</strong>
        <p>Первые материалы появятся здесь после ближайшего обновления.</p>
        <a href={ROBLOX_CHANNEL.telegram.url} rel="noopener noreferrer" target="_blank">
          Пока открыть Roblox Hub
        </a>
      </div>
    )}
  </section>
</BaseLayout>
