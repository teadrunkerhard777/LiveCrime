---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { CRIME_CHANNELS } from "../../config/channels";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublishableEvent } from "../../lib/content-quality";
import {
  EVENT_STATUS_LABELS,
  LEGAL_STATUS_LABELS,
  formatDate,
  formatEventDate,
  withBase,
} from "../../lib/events";

export async function getStaticPaths() {
  const events = (await getCollection("events")).filter(isPublishableEvent);
  const eventsById = new Map(events.map((event) => [event.id, event]));

  return events.map((event) => ({
    params: { id: event.id },
    props: {
      event,
      relatedEvents: event.data.related_events
        .map((id) => eventsById.get(id))
        .filter((related): related is CollectionEntry<"events"> => Boolean(related)),
    },
  }));
}

interface Props {
  event: CollectionEntry<"events">;
  relatedEvents: CollectionEntry<"events">[];
}

const { event, relatedEvents } = Astro.props;
const { Content } = await render(event);
const place = [
  event.data.location.locality,
  event.data.location.region,
  event.data.location.country,
].join(", ");
const pageUrl = new URL(withBase(`/crime/${event.id}/`), Astro.site ?? Astro.url).toString();
const homeUrl = new URL(withBase("/"), Astro.site ?? Astro.url).toString();
const crimeUrl = new URL(withBase("/crime/"), Astro.site ?? Astro.url).toString();
const structuredData = event.data.demo ? undefined : [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: event.data.title,
    description: event.data.summary,
    datePublished: event.data.created_at.toISOString(),
    dateModified: event.data.updated_at.toISOString(),
    image: event.data.image ? [event.data.image.url] : undefined,
    mainEntityOfPage: pageUrl,
    author: { "@type": "Organization", name: "По факту", url: homeUrl },
    publisher: { "@type": "Organization", name: "По факту", url: homeUrl },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Главная", item: homeUrl },
      { "@type": "ListItem", position: 2, name: "Криминал", item: crimeUrl },
      { "@type": "ListItem", position: 3, name: event.data.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={`${event.data.title} — По факту`}
  description={event.data.summary}
  noindex={event.data.demo}
  canonicalPath={`/crime/${event.id}/`}
  ogType="article"
  socialImage={event.data.image?.url}
  socialImageAlt={event.data.image?.alt}
  structuredData={structuredData}
>
  <article class="event-page">
    <header class="event-sheet shell">
      <div class="event-sheet-topline">
        <nav class="event-breadcrumbs" aria-label="Хлебные крошки">
          <a href={withBase("/")}>По факту</a>
          <span aria-hidden="true">·</span>
          <a href={withBase("/crime/")}>Криминал</a>
        </nav>
        <span>
          Источников: {event.data.sources.length} · обновлений: {event.data.updates.length}
        </span>
      </div>
      {event.data.demo && (
        <div class="demo-banner">
          Учебный пример: событие, источники и обновления вымышлены.
        </div>
      )}
      <div class="event-title-grid">
        <div>
          <span class="event-state">{EVENT_STATUS_LABELS[event.data.status]}</span>
          <h1>{event.data.title}</h1>
          <p class="lead">{event.data.summary}</p>
        </div>
        <div class="registry-stamp" aria-label="Дата последнего обновления">
          <span>обновлено</span>
          <strong>{formatDate(event.data.updated_at)}</strong>
        </div>
      </div>
      <dl class="facts-ledger">
        <div>
          <dt>Дата события</dt>
          <dd>{formatEventDate(event.data.event_date)}</dd>
        </div>
        <div>
          <dt>Место</dt>
          <dd>{place}</dd>
        </div>
        <div>
          <dt>Источников</dt>
          <dd>{event.data.sources.length}</dd>
        </div>
        <div>
          <dt>Обновлений</dt>
          <dd>{event.data.updates.length}</dd>
        </div>
        <div>
          <dt>Юридический статус</dt>
          <dd>{LEGAL_STATUS_LABELS[event.data.legal_status]}</dd>
        </div>
      </dl>
    </header>

    <div class="shell event-layout">
      <div class="event-main">
        <section class="content-section">
          <h2>Что известно</h2>
          <div class="article-content"><Content /></div>
        </section>

        <section class="content-section">
          <h2>Как развивалась история</h2>
          <ol class="timeline">
            {event.data.updates.map((update, index) => (
              <li>
                <div class="timeline-index">{String(index + 1).padStart(2, "0")}</div>
                <div>
                  <time datetime={update.date}>{formatEventDate(update.date)}</time>
                  <h3>{update.title}</h3>
                  <p>{update.summary}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        {relatedEvents.length > 0 && (
          <section class="content-section related-section">
            <h2>Связанные материалы</h2>
            <ul>
              {relatedEvents.map((related) => (
                <li>
                  <a href={withBase(`/crime/${related.id}/`)}>
                    {related.data.title}
                  </a>
                  <span>{formatEventDate(related.data.event_date)}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="event-sidebar">
        <section class="source-sheet">
          <h2>Источники</h2>
          <ul class="source-list">
            {event.data.sources.map((source, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <a href={source.url} rel="noopener noreferrer" target="_blank">
                    {source.name}
                  </a>
                  {source.published_at && <small>{formatDate(source.published_at)}</small>}
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="channel-sheet">
          <span>Следите за продолжением</span>
          <h2>Оперативно — в мессенджерах</h2>
          <p>Новые публикации и продолжение историй выходят в каналах «По факту».</p>
          <div class="channel-links">
            <a href={CRIME_CHANNELS.telegram.url} rel="noopener noreferrer" target="_blank">
              Открыть Telegram
            </a>
            <a href={CRIME_CHANNELS.max.url} rel="noopener noreferrer" target="_blank">
              Открыть MAX
            </a>
          </div>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
