---
import { getCollection } from "astro:content";
import TelegramPostCard from "../../components/TelegramPostCard.astro";
import { CRIME_CHANNELS } from "../../config/channels";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("crimeFeed")).sort(
  (first, second) => second.data.published_at.valueOf() - first.data.published_at.valueOf(),
);
---

<BaseLayout
  title="Криминальные новости — свежие публикации | По факту"
  description="Свежие криминальные новости и происшествия из Telegram-канала «Новости преступления 24/7» с фотографиями и ссылками на оригинальные публикации."
  canonicalPath="/crime/"
>
  <header class="section-masthead">
    <div class="shell masthead-grid">
      <div>
        <h1>Криминал</h1>
      </div>
      <div class="masthead-copy">
        <p>
          Свежие криминальные новости, происшествия и важные обновления. Каждый
          материал можно открыть в Telegram или продолжить чтение в MAX.
        </p>
        <div class="masthead-actions" aria-label="Криминал в мессенджерах">
          <a href={CRIME_CHANNELS.telegram.url} rel="noopener noreferrer" target="_blank">
            Читать в Telegram
          </a>
          <a href={CRIME_CHANNELS.max.url} rel="noopener noreferrer" target="_blank">
            Читать в MAX
          </a>
        </div>
      </div>
    </div>
  </header>

  <section class="shell roblox-feed crime-feed" aria-labelledby="crime-list-title">
    <div class="roblox-feed-heading">
      <div>
        <span>Криминальные новости</span>
        <h2 id="crime-list-title">Последние публикации</h2>
      </div>
      <p>{posts.length} {posts.length === 1 ? "пост" : "постов"}</p>
    </div>

    {posts.length ? (
      <div class="roblox-posts">
        {posts.map((post) => (
          <TelegramPostCard
            post={post}
            channelName="Новости преступления 24/7"
            imageAlt="Изображение из криминальной публикации"
            maxUrl={CRIME_CHANNELS.max.url}
          />
        ))}
      </div>
    ) : (
      <div class="roblox-empty">
        <strong>Лента подключена</strong>
        <p>Первые публикации появятся здесь после ближайшего обновления.</p>
        <a href={CRIME_CHANNELS.telegram.url} rel="noopener noreferrer" target="_blank">
          Пока открыть канал в Telegram
        </a>
      </div>
    )}
  </section>
</BaseLayout>
