---
import HubTopicCard from "../components/HubTopicCard.astro";
import { HUB_TOPIC_GROUPS } from "../config/hub-topics";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/events";
---

<BaseLayout
  title="По факту — тематический медиахаб"
  description="Выбирайте интересующую тему: события, спорт, автомобили, игры, животные, технологии и звёзды — в одном медиахабе."
  canonicalPath="/"
  hubHome
>
  <div class="hub-home">
    <header class="hub-hero shell">
      <h1>Выбирай, что интересно.</h1>
      <p>Новости, истории и развлечения из разных миров — в одном месте.</p>
    </header>

    <div class="hub-directory shell" id="themes">
      {HUB_TOPIC_GROUPS.map((group) => (
        <section class={`hub-group hub-group-${group.id}`} aria-labelledby={`hub-${group.id}`}>
          <div class="hub-group-heading">
            <h2 id={`hub-${group.id}`}>{group.title}</h2>
            <span>{group.topics.length} темы</span>
          </div>
          <div class="hub-card-grid">
            {group.topics.map((topic) => <HubTopicCard topic={topic} />)}
          </div>
        </section>
      ))}
    </div>

    <footer class="hub-closing shell">
      <p>Каждая тема живёт своим характером. Всё важное собрано в одном месте.</p>
      <a href={withBase("/about/")}>Как устроен «По факту»</a>
    </footer>
  </div>
</BaseLayout>
