---
import { getCollection } from "astro:content";
import EventCard from "../components/EventCard.astro";
import { CRIME_CHANNELS } from "../config/channels";
import BaseLayout from "../layouts/BaseLayout.astro";
import { isPublishableEvent } from "../lib/content-quality";
import { withBase } from "../lib/events";

const publishableEvents = (await getCollection("events")).filter(isPublishableEvent);
const realEvents = publishableEvents.filter(({ data }) => !data.demo);
const events = (realEvents.length ? realEvents : publishableEvents).sort(
  (first, second) => second.data.updated_at.valueOf() - first.data.updated_at.valueOf(),
);
---

<BaseLayout
  title="По факту — события, источники и обновления"
  description="По факту собирает главное о событиях в понятных карточках с источниками, статусами и хронологией обновлений."
  canonicalPath="/"
>
  <section class="shell registry-section" aria-labelledby="latest-title">
    <div class="section-title-row">
      <h2 id="latest-title">Последние записи</h2>
      <p>{events.length} {events.length === 1 ? "материал" : "материала"}</p>
    </div>
    {events.every(({ data }) => data.demo) && (
      <div class="demo-note">
        Сейчас интерфейс проверяется на вымышленном примере. Реальные материалы
        появятся только после подключения отдельного безопасного процесса.
      </div>
    )}
    <div class="registry-list">
      {events.map((event, index) => <EventCard event={event} index={index} />)}
    </div>
  </section>

  <section class="home-intro">
    <div class="shell home-intro-grid">
      <h1>Главное остаётся на своём месте.</h1>
      <div>
        <p>
          Собираем факты, источники и важные обновления одной истории на
          постоянной странице — чтобы к ней можно было вернуться после первой
          новости.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href={withBase("/crime/")}>Все криминальные истории</a>
          <a class="text-action" href={withBase("/about/")}>Как устроен проект</a>
        </div>
      </div>
    </div>
  </section>

  <section class="topic-ledger" aria-labelledby="channels-title">
    <div class="shell topic-grid">
      <div>
        <h2 id="channels-title">Продолжение — в каналах</h2>
        <p>
          На сайте история остаётся собранной, а свежие публикации выходят там,
          где вам удобнее читать.
        </p>
      </div>
      <div class="channel-register" aria-label="Каналы криминального направления">
        <a href={CRIME_CHANNELS.telegram.url} rel="noopener noreferrer" target="_blank">
          <span><strong>Telegram</strong><small>Оперативные публикации</small></span>
          <b aria-hidden="true">↗</b>
        </a>
        <a href={CRIME_CHANNELS.max.url} rel="noopener noreferrer" target="_blank">
          <span><strong>MAX</strong><small>Тот же канал в приложении</small></span>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
    <div class="shell hub-future">
      <span>«По факту» растёт как тематический хаб</span>
      <p>Дальше: Roblox · кошки · MMA · авто · звёзды</p>
    </div>
  </section>
</BaseLayout>
