---
import type { HubTopic } from "../config/hub-topics";
import { withBase } from "../lib/events";

interface Props {
  topic: HubTopic;
}

const { topic } = Astro.props;
const className = `hub-card hub-card-${topic.theme}${topic.size === "wide" ? " hub-card-wide" : ""}`;
---

{topic.url ? (
  <a class={className} href={withBase(topic.url)} aria-label={`${topic.title}: ${topic.subtitle}`}>
    <span class="hub-card-art" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </span>
    <span class="hub-card-copy">
      <span class="hub-card-status">Открыть раздел</span>
      <strong>{topic.title}</strong>
      <small>{topic.subtitle}</small>
    </span>
    <svg class="hub-card-arrow" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M7 25 25 7M11 7h14v14"></path>
    </svg>
  </a>
) : (
  <article class={`${className} hub-card-upcoming`} aria-label={`${topic.title}: скоро`}>
    <span class="hub-card-art" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </span>
    <span class="hub-card-copy">
      <span class="hub-card-status">Скоро</span>
      <strong>{topic.title}</strong>
      <small>{topic.subtitle}</small>
    </span>
    <span class="hub-card-dot" aria-hidden="true"></span>
  </article>
)}
