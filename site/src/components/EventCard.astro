---
import type { CollectionEntry } from "astro:content";
import { EVENT_STATUS_LABELS, formatDate, formatEventDate, withBase } from "../lib/events";

interface Props {
  event: CollectionEntry<"events">;
  index?: number;
  featured?: boolean;
}

const { event, index = 0, featured = false } = Astro.props;
const place = `${event.data.location.locality}, ${event.data.location.region}`;
const registryNumber = String(index + 1).padStart(3, "0");
---

<article class:list={["event-row", { featured, "has-media": event.data.image }]}>
  <div class="event-number" aria-label={`Запись ${registryNumber}`}>
    <span>№</span>{registryNumber}
  </div>
  {event.data.image && (
    <a class="event-media" href={withBase(`/crime/${event.id}/`)} aria-label={`Открыть: ${event.data.title}`}>
      <img
        src={event.data.image.url}
        alt={event.data.image.alt}
        loading={featured ? "eager" : "lazy"}
        decoding="async"
      />
      <span>{event.data.image.credit}</span>
    </a>
  )}
  <div class="event-copy">
    <div class="event-meta">
      <span>
        Опубликовано <time datetime={event.data.created_at.toISOString()}>
          {formatDate(event.data.created_at)}
        </time>
      </span>
      <time datetime={event.data.event_date}>
        Событие: {formatEventDate(event.data.event_date)}
      </time>
      <span>{place}</span>
    </div>
    <h2>
      <a href={withBase(`/crime/${event.id}/`)}>{event.data.title}</a>
    </h2>
    <p>{event.data.summary}</p>
  </div>
  <div class="event-action">
    <span class="status-label">{EVENT_STATUS_LABELS[event.data.status]}</span>
    <a href={withBase(`/crime/${event.id}/`)}>Открыть карточку</a>
  </div>
</article>
